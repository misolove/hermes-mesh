[Unit]
Description=Hermes Mesh Daemon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-mesh
EnvironmentFile=/etc/hermes-mesh/hermes-daemon.env
ExecStart=/opt/hermes-mesh/.venv/bin/hermes-mesh-daemon --config /etc/hermes-mesh/node.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/hermes-mesh /var/log/hermes-mesh

[Install]
WantedBy=multi-user.target
